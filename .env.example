# NutriLift Environment Variables

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/nutrilift
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3000

# Security
JWT_SECRET=nutrilift_super_secret_jwt_key_with_at_least_32_bytes_2026!
JWT_EXPIRATION_MS=604800000

# Google Gemini AI Integration (gemini-1.5-flash / gemini-2.5-flash)
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional: Separate key dedicated to plate vision scanner for isolated rate limits
GEMINI_VISION_API_KEY=your_optional_second_gemini_vision_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
